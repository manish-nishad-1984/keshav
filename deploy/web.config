<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="apps/api/server.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="NodeApp" stopProcessing="true">
          <match url="/*" />
          <action type="Rewrite" url="apps/api/server.js" />
        </rule>
      </rules>
    </rewrite>
    <!-- Let the Node app send its own JSON error bodies (401/400/404...) instead of IIS error pages. -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
