NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ck_fast?schema=public

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_REFRESH_TTL_LONG=30d
JWT_ISSUER=ck-fast

WEB_ORIGIN=http://localhost:5173
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
BCRYPT_ROUNDS=12

SEED_ORG_CODE=CKFAST
SEED_ADMIN_EMAIL=admin@ckfast.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_COMPANY_NAME=CK Fast
