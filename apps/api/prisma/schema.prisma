generator client {
  provider      = "prisma-client-js"
  // "windows" alongside the Linux build container's own "native" target: the
  // Railpack build runs in Linux Docker, but the built output is then copied
  // onto the Windows/IISNode host to actually run, so the generated client
  // needs a Windows-compatible query engine binary bundled in too.
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Organization {
  id                   String    @id @default(uuid()) @db.Uuid
  code                 String    @unique
  name                 String
  legalName            String?
  ownerName            String?
  gstNumber            String?
  email                String?
  phone                String?
  website              String?
  logoUrl              String?
  addressLine1         String?
  addressLine2         String?
  pincode              String?
  country              String    @default("India")
  currency             String    @default("INR")
  timezone             String    @default("Asia/Kolkata")
  fiscalYearStartMonth Int       @default(4)
  autoBackupEnabled    Boolean   @default(false)
  // 24-hour "HH:mm" (e.g. "23:00") in the organization's own timezone, not UTC.
  autoBackupTime       String?
  isActive             Boolean   @default(true)
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  createdById          String?   @db.Uuid
  updatedById          String?   @db.Uuid

  branches          Branch[]
  users             User[]
  roles             Role[]
  auditLogs         AuditLog[]
  numberSequences   NumberSequence[]
  companySettings   CompanySetting[]
  karigars          Karigar[]
  itemCategories    ItemCategory[]
  items             Item[]
  workTypes         WorkType[]
  patternTypes      PatternType[]
  colors            Color[]
  cuttingEntries    CuttingEntry[]
  productionEntries ProductionEntry[]
  payments          Payment[]
  backups           Backup[]

  @@map("organizations")
}

model Branch {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  code           String
  name           String
  addressLine1   String?
  pincode        String?
  phone          String?
  email          String?
  isHeadOffice   Boolean   @default(false)
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?   @db.Uuid
  updatedById    String?   @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]

  @@unique([organizationId, code])
  @@map("branches")
}

// ---------------------------------------------------------------------------
// Users
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  organizationId      String     @db.Uuid
  branchId            String?    @db.Uuid
  employeeCode        String?
  fullName            String
  email               String     @unique
  mobile              String?
  passwordHash        String
  avatarUrl           String?
  designation         String?
  status              UserStatus @default(ACTIVE)
  isSuperAdmin        Boolean    @default(false)
  mustChangePassword  Boolean    @default(false)
  tokenVersion        Int        @default(1)
  lastLoginAt         DateTime?
  lastLoginIp         String?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  reportsToId         String?    @db.Uuid
  isActive            Boolean    @default(true)
  deletedAt           DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  createdById         String?    @db.Uuid
  updatedById         String?    @db.Uuid

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?              @relation(fields: [branchId], references: [id])
  reportsTo      User?                @relation("UserReportsTo", fields: [reportsToId], references: [id])
  reports        User[]               @relation("UserReportsTo")
  roles          UserRole[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordResetToken[]

  @@unique([organizationId, employeeCode])
  @@map("users")
}

// ---------------------------------------------------------------------------
// RBAC
// ---------------------------------------------------------------------------

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  module      String
  action      String
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model Role {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  slug           String
  description    String?
  isSystem       Boolean   @default(false)
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  permissions  RolePermission[]
  users        UserRole[]
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug])
  @@map("roles")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())
  createdById  String?  @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  roleId      String   @db.Uuid
  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Auth tokens
// ---------------------------------------------------------------------------

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  tokenHash         String    @unique
  familyId          String    @db.Uuid
  expiresAt         DateTime
  revokedAt         DateTime?
  revokedReason     String?
  replacedByTokenId String?   @db.Uuid
  userAgent         String?
  ipAddress         String?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_CHANGE
  PASSWORD_RESET
  PERMISSION_CHANGE
  STATUS_CHANGE
  EXPORT
  IMPORT
}

model AuditLog {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String?     @db.Uuid
  action         AuditAction
  entityType     String
  entityId       String?
  entityLabel    String?
  oldValues      Json?
  newValues      Json?
  changedFields  String[]
  actorId        String?     @db.Uuid
  actorEmail     String?
  ipAddress      String?
  userAgent      String?
  requestId      String?
  createdAt      DateTime    @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Numbering & settings
// ---------------------------------------------------------------------------

model NumberSequence {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  prefix         String
  fiscalYear     String
  nextValue      Int      @default(1)
  padTo          Int      @default(4)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, prefix, fiscalYear])
  @@map("number_sequences")
}

model CompanySetting {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  scope          String
  key            String
  value          Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, scope, key])
  @@map("company_settings")
}

model SystemSetting {
  id         String   @id @default(uuid()) @db.Uuid
  key        String   @unique
  value      Json
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("system_settings")
}

// ---------------------------------------------------------------------------
// Business modules — GarmentTrack
// ---------------------------------------------------------------------------

// Hard-deleted, same reasoning as ItemCategory: `name` is user-chosen text under a hard
// uniqueness constraint, so a soft-deleted row would permanently block reusing that name.
model WorkType {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?  @db.Uuid
  updatedById    String?  @db.Uuid

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  karigars          Karigar[]
  productionEntries ProductionEntry[]

  @@unique([organizationId, name])
  @@map("work_types")
}

model PatternType {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?  @db.Uuid
  updatedById    String?  @db.Uuid

  organization              Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cuttingEntriesAsPattern   CuttingEntry[] @relation("CuttingEntryPatternType")
  cuttingEntriesAsCharacter CuttingEntry[] @relation("CuttingEntryCharacter")

  @@unique([organizationId, name])
  @@map("pattern_types")
}

model Color {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?  @db.Uuid
  updatedById    String?  @db.Uuid

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cuttingEntries CuttingEntry[]

  @@unique([organizationId, name])
  @@map("colors")
}

model Karigar {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  code           String
  fullName       String
  mobile         String
  photoUrl       String?
  workTypeId     String    @db.Uuid
  joinDate       DateTime?
  address        String?
  remarks        String?
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?   @db.Uuid
  updatedById    String?   @db.Uuid

  organization           Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workType               WorkType          @relation(fields: [workTypeId], references: [id])
  carrierEntries         ProductionEntry[] @relation("ProductionEntryCarrier")
  overlockCarrierEntries ProductionEntry[] @relation("ProductionEntryOverlockCarrier")
  flatlockKarigarEntries ProductionEntry[] @relation("ProductionEntryFlatlockKarigar")
  payments               Payment[]

  @@unique([organizationId, code])
  @@map("karigars")
}

// Hard-deleted, not soft-deleted like the other masters: name/prefix are user-chosen text under
// a hard uniqueness constraint, and a soft-deleted row would permanently block reusing that
// name/prefix. The service-level guard already blocks deleting a category any item references,
// so nothing of value is lost by removing the row outright.
model ItemCategory {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  prefix         String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?  @db.Uuid
  updatedById    String?  @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        Item[]

  @@unique([organizationId, name])
  @@unique([organizationId, prefix])
  @@map("item_categories")
}

model Item {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  categoryId     String    @db.Uuid
  styleNo        String
  itemName       String
  photoUrl       String?
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?   @db.Uuid
  updatedById    String?   @db.Uuid

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category          ItemCategory      @relation(fields: [categoryId], references: [id])
  productionEntries ProductionEntry[]
  CuttingEntry      CuttingEntry[]

  @@unique([organizationId, styleNo])
  @@map("items")
}

enum AverageUnit {
  KILOGRAM
  METER
}

// The first stage of production — a cutting "lot". Daily Production Entry later looks a
// lot number up against this table to auto-fill and lock its item/quantity fields.
model CuttingEntry {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  lotNumber      String
  date           DateTime    @db.Date
  patternTypeId  String      @db.Uuid
  characterId    String      @db.Uuid
  isOnline       Boolean
  itemId         String      @db.Uuid
  partyName      String
  averageValue   Decimal     @db.Decimal(10, 2)
  averageUnit    AverageUnit
  colorId        String      @db.Uuid
  // Denormalized sum of this entry's lines' totals, computed server-side on every write —
  // same convention as ProductionEntry.carrierTotal etc., never trust a client-supplied total.
  totalAmount    Decimal     @db.Decimal(12, 2)
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  createdById    String?     @db.Uuid
  updatedById    String?     @db.Uuid

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  patternType       PatternType        @relation("CuttingEntryPatternType", fields: [patternTypeId], references: [id])
  character         PatternType        @relation("CuttingEntryCharacter", fields: [characterId], references: [id])
  item              Item               @relation(fields: [itemId], references: [id])
  color             Color              @relation(fields: [colorId], references: [id])
  lines             CuttingEntryLine[]
  productionEntries ProductionEntry[]

  @@unique([organizationId, lotNumber])
  @@map("cutting_entries")
}

// One size/quantity/rate row within a cutting lot (a single lot commonly spans several
// sizes — S/M/L/XL — each cut in a different quantity).
model CuttingEntryLine {
  id             String   @id @default(uuid()) @db.Uuid
  cuttingEntryId String   @db.Uuid
  size           String
  quantity       Int
  rate           Decimal  @db.Decimal(10, 2)
  // Denormalized (quantity * rate), computed server-side — see CuttingEntry.totalAmount.
  total          Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cuttingEntry CuttingEntry @relation(fields: [cuttingEntryId], references: [id], onDelete: Cascade)

  @@map("cutting_entry_lines")
}

model ProductionEntry {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  date           DateTime @db.Date
  // Nullable: older entries predate lot tracking, and not every entry may originate from a
  // cutting lot. When set, itemId/carrierQuantity are auto-filled from the matched
  // CuttingEntry and locked client-side (not enforced at the DB level).
  cuttingEntryId String?  @db.Uuid
  lotNumber      String?
  designNumber   String?
  workTypeId     String   @db.Uuid
  itemId         String   @db.Uuid

  carrierId       String  @db.Uuid
  carrierQuantity Int
  carrierRate     Decimal @db.Decimal(10, 2)
  // Denormalized (carrierQuantity * carrierRate), computed server-side on every write — never
  // trust a client-supplied total, and reports/ledger queries read this column directly instead
  // of recomputing it every time. Same convention for overlockTotal/flatlockTotal below.
  carrierTotal    Decimal @db.Decimal(12, 2)

  // Overlock and Flatlock are separate finishing stages, each optionally done by a different
  // karigar than the main carrier — both nullable since not every entry needs either.
  overlockCarrierId String?  @db.Uuid
  overlockRate      Decimal? @db.Decimal(10, 2)
  overlockTotal     Decimal? @db.Decimal(12, 2)

  flatlockKarigarId String?  @db.Uuid
  flatlockRate      Decimal? @db.Decimal(10, 2)
  flatlockTotal     Decimal? @db.Decimal(12, 2)

  photoUrl    String?
  remarks     String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cuttingEntry    CuttingEntry? @relation(fields: [cuttingEntryId], references: [id])
  workType        WorkType      @relation(fields: [workTypeId], references: [id])
  item            Item          @relation(fields: [itemId], references: [id])
  carrier         Karigar       @relation("ProductionEntryCarrier", fields: [carrierId], references: [id])
  overlockCarrier Karigar?      @relation("ProductionEntryOverlockCarrier", fields: [overlockCarrierId], references: [id])
  flatlockKarigar Karigar?      @relation("ProductionEntryFlatlockKarigar", fields: [flatlockKarigarId], references: [id])

  @@map("production_entries")
}

// A small, universal, fixed set — unlike WorkType/ItemCategory this isn't something the client
// customizes per-organization, so a plain enum (not a manageable master) is the right call here.
enum PaymentMode {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
}

model Payment {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  karigarId      String      @db.Uuid
  date           DateTime    @db.Date
  amount         Decimal     @db.Decimal(12, 2)
  paymentMode    PaymentMode
  referenceNo    String?
  remarks        String?
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  createdById    String?     @db.Uuid
  updatedById    String?     @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  karigar      Karigar      @relation(fields: [karigarId], references: [id])

  @@map("payments")
}

enum BackupTrigger {
  MANUAL
  AUTO
}

// A full backup's data is stored as JSON right in Postgres rather than on the filesystem — this
// app already keeps everything in the DB, and a JSON column sidesteps any filesystem/deployment
// path concerns for something that only needs to be written once and read back occasionally.
model Backup {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  triggeredBy    BackupTrigger
  payload        Json
  sizeBytes      Int
  createdAt      DateTime      @default(now())
  createdById    String?       @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("backups")
}
