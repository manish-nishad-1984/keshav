generator client {
  provider      = "prisma-client-js"
  // "windows" alongside the Linux build container's own "native" target: the
  // Railpack build runs in Linux Docker, but the built output is then copied
  // onto the Windows/IISNode host to actually run, so the generated client
  // needs a Windows-compatible query engine binary bundled in too.
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Organization {
  id                   String    @id @default(uuid()) @db.Uuid
  code                 String    @unique
  name                 String
  legalName            String?
  ownerName            String?
  gstNumber            String?
  email                String?
  phone                String?
  website              String?
  logoUrl              String?
  addressLine1         String?
  addressLine2         String?
  pincode              String?
  country              String    @default("India")
  currency             String    @default("INR")
  timezone             String    @default("Asia/Kolkata")
  fiscalYearStartMonth Int       @default(4)
  autoBackupEnabled    Boolean   @default(false)
  // 24-hour "HH:mm" (e.g. "23:00") in the organization's own timezone, not UTC.
  autoBackupTime       String?
  isActive             Boolean   @default(true)
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  createdById          String?   @db.Uuid
  updatedById          String?   @db.Uuid

  branches              Branch[]
  users                 User[]
  roles                 Role[]
  auditLogs             AuditLog[]
  numberSequences       NumberSequence[]
  companySettings       CompanySetting[]
  karigars              Karigar[]
  itemCategories        ItemCategory[]
  items                 Item[]
  workTypes             WorkType[]
  patternTypes          PatternType[]
  colors                Color[]
  cuttingEntries        CuttingEntry[]
  productionEntries     ProductionEntry[]
  payments              Payment[]
  backups               Backup[]
  parties               Party[]
  books                 Book[]
  sizes                 Size[]
  cuttingDistributions  CuttingDistribution[]
  accessories           Accessory[]
  accessoryTransactions AccessoryTransaction[]
  pressEntries          PressEntry[]
  deliveries            Delivery[]

  @@map("organizations")
}

model Branch {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  code           String
  name           String
  addressLine1   String?
  pincode        String?
  phone          String?
  email          String?
  isHeadOffice   Boolean   @default(false)
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?   @db.Uuid
  updatedById    String?   @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]

  @@unique([organizationId, code])
  @@map("branches")
}

// ---------------------------------------------------------------------------
// Users
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  organizationId      String     @db.Uuid
  branchId            String?    @db.Uuid
  employeeCode        String?
  fullName            String
  email               String     @unique
  mobile              String?
  passwordHash        String
  avatarUrl           String?
  designation         String?
  status              UserStatus @default(ACTIVE)
  isSuperAdmin        Boolean    @default(false)
  mustChangePassword  Boolean    @default(false)
  tokenVersion        Int        @default(1)
  lastLoginAt         DateTime?
  lastLoginIp         String?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  reportsToId         String?    @db.Uuid
  isActive            Boolean    @default(true)
  deletedAt           DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  createdById         String?    @db.Uuid
  updatedById         String?    @db.Uuid

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch?              @relation(fields: [branchId], references: [id])
  reportsTo      User?                @relation("UserReportsTo", fields: [reportsToId], references: [id])
  reports        User[]               @relation("UserReportsTo")
  roles          UserRole[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordResetToken[]

  @@unique([organizationId, employeeCode])
  @@map("users")
}

// ---------------------------------------------------------------------------
// RBAC
// ---------------------------------------------------------------------------

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  module      String
  action      String
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model Role {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  slug           String
  description    String?
  isSystem       Boolean   @default(false)
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  permissions  RolePermission[]
  users        UserRole[]
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, slug])
  @@map("roles")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now())
  createdById  String?  @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  roleId      String   @db.Uuid
  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Auth tokens
// ---------------------------------------------------------------------------

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  tokenHash         String    @unique
  familyId          String    @db.Uuid
  expiresAt         DateTime
  revokedAt         DateTime?
  revokedReason     String?
  replacedByTokenId String?   @db.Uuid
  userAgent         String?
  ipAddress         String?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_CHANGE
  PASSWORD_RESET
  PERMISSION_CHANGE
  STATUS_CHANGE
  EXPORT
  IMPORT
}

model AuditLog {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String?     @db.Uuid
  action         AuditAction
  entityType     String
  entityId       String?
  entityLabel    String?
  oldValues      Json?
  newValues      Json?
  changedFields  String[]
  actorId        String?     @db.Uuid
  actorEmail     String?
  ipAddress      String?
  userAgent      String?
  requestId      String?
  createdAt      DateTime    @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Numbering & settings
// ---------------------------------------------------------------------------

model NumberSequence {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  prefix         String
  fiscalYear     String
  nextValue      Int      @default(1)
  padTo          Int      @default(4)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, prefix, fiscalYear])
  @@map("number_sequences")
}

model CompanySetting {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  scope          String
  key            String
  value          Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, scope, key])
  @@map("company_settings")
}

model SystemSetting {
  id         String   @id @default(uuid()) @db.Uuid
  key        String   @unique
  value      Json
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("system_settings")
}

// ---------------------------------------------------------------------------
// Business modules — GarmentTrack
// ---------------------------------------------------------------------------

// Hard-deleted, same reasoning as ItemCategory: `name` is user-chosen text under a hard
// uniqueness constraint, so a soft-deleted row would permanently block reusing that name.
model WorkType {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?  @db.Uuid
  updatedById    String?  @db.Uuid

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  karigars          Karigar[]
  productionEntries ProductionEntry[]

  @@unique([organizationId, name])
  @@map("work_types")
}

model PatternType {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?  @db.Uuid
  updatedById    String?  @db.Uuid

  organization            Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cuttingEntriesAsPattern CuttingEntry[] @relation("CuttingEntryPatternType")

  @@unique([organizationId, name])
  @@map("pattern_types")
}

model Color {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?  @db.Uuid
  updatedById    String?  @db.Uuid

  organization           Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cuttingRows            CuttingEntryRow[]
  distributionQuantities CuttingDistributionQuantity[]
  deliveryQuantities     DeliveryQuantity[]

  @@unique([organizationId, name])
  @@map("colors")
}

model Karigar {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  code           String
  fullName       String
  mobile         String
  photoUrl       String?
  workTypeId     String    @db.Uuid
  joinDate       DateTime?
  address        String?
  remarks        String?
  // Fixed-salary karigars (work type "Fixed") are paid by attendance: per day = this ÷ 30.
  monthlySalary  Decimal?  @db.Decimal(12, 2)
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?   @db.Uuid
  updatedById    String?   @db.Uuid

  organization           Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workType               WorkType               @relation(fields: [workTypeId], references: [id])
  carrierEntries         ProductionEntry[]      @relation("ProductionEntryCarrier")
  overlockCarrierEntries ProductionEntry[]      @relation("ProductionEntryOverlockCarrier")
  flatlockKarigarEntries ProductionEntry[]      @relation("ProductionEntryFlatlockKarigar")
  payments               Payment[]
  cuttingDistributions   CuttingDistribution[]
  accessoryTransactions  AccessoryTransaction[]
  pressEntries           PressEntry[]
  documents              KarigarDocument[]

  @@unique([organizationId, code])
  @@map("karigars")
}

// Hard-deleted, not soft-deleted like the other masters: name/prefix are user-chosen text under
// a hard uniqueness constraint, and a soft-deleted row would permanently block reusing that
// name/prefix. The service-level guard already blocks deleting a category any item references,
// so nothing of value is lost by removing the row outright.
enum KarigarDocumentType {
  AADHAAR_FRONT
  AADHAAR_BACK
  PAN
  OTHER
}

// ID proofs of a karigar: one photo each for Aadhaar front/back and PAN, and any number of other
// proofs with their own name (e.g. Voter ID). Replaced wholesale whenever the karigar is saved.
model KarigarDocument {
  id        String              @id @default(uuid()) @db.Uuid
  karigarId String              @db.Uuid
  type      KarigarDocumentType
  // Name of an OTHER proof; empty for the fixed types.
  label     String?
  fileUrl   String
  sortOrder Int                 @default(0)
  createdAt DateTime            @default(now())

  karigar Karigar @relation(fields: [karigarId], references: [id], onDelete: Cascade)

  @@index([karigarId])
  @@map("karigar_documents")
}

model ItemCategory {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  prefix         String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?  @db.Uuid
  updatedById    String?  @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        Item[]

  @@unique([organizationId, name])
  @@unique([organizationId, prefix])
  @@map("item_categories")
}

model Item {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  categoryId     String    @db.Uuid
  // Shown as "Design Name" in the UI. Unique among non-deleted items (enforced in the service,
  // since soft-deleted rows would otherwise block reusing a name).
  itemName       String
  photoUrl       String?
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?   @db.Uuid
  updatedById    String?   @db.Uuid

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category          ItemCategory      @relation(fields: [categoryId], references: [id])
  productionEntries ProductionEntry[]
  CuttingEntry      CuttingEntry[]
  accessories       ItemAccessory[]

  @@map("items")
}

enum AverageUnit {
  KILOGRAM
  METER
}

// A book is a lot-number series, typically one per financial year ("2025-26"). Lot numbers are
// generated per book, starting at startNumber; the user picks the working book in the header.
// Hard-deleted (like WorkType) and only when no cutting entry uses it.
model Book {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  startNumber    Int      @default(1)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?  @db.Uuid
  updatedById    String?  @db.Uuid

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cuttingEntries CuttingEntry[]

  @@unique([organizationId, name])
  @@map("books")
}

// Hard-deleted (like WorkType) and only when no cutting entry uses it; deactivate instead to
// hide a party from new entries while keeping its history.
model Party {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  mobile         String?
  referenceName  String?
  address        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?  @db.Uuid
  updatedById    String?  @db.Uuid

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cuttingEntries CuttingEntry[]
  deliveries     Delivery[]

  @@unique([organizationId, name])
  @@map("parties")
}

// The first stage of production — a cutting "lot". Daily Production Entry later looks a
// lot number up against this table (within the selected book) to auto-fill and lock its
// item/quantity fields.
model CuttingEntry {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  bookId         String      @db.Uuid
  // Generated server-side as the next number in the book (see cutting.service); never entered
  // by the user. Text because lots created before books existed may not be numeric.
  lotNumber      String
  date           DateTime    @db.Date
  patternTypeId  String      @db.Uuid
  isOnline       Boolean
  itemId         String      @db.Uuid
  partyId        String      @db.Uuid
  // Nullable only for lots created before this field existed; required for new entries.
  // PCs and Avg go together: Avg is the fabric used for PCs pieces (e.g. 4 pcs = 1.53 kg), so the
  // lot's total fabric = totalQuantity / pieces * averageValue (computed for display).
  pieces         Int?
  averageValue   Decimal     @db.Decimal(10, 3)
  averageUnit    AverageUnit
  // Optional time of day, "HH:mm", kept apart from the date-only `date` column.
  entryTime      String?
  // Denormalized sum of every row's quantities, computed server-side on every write.
  totalQuantity  Int         @default(0)
  // Legacy: lots created before rates were removed (Oct 2026) keep their old amount; new lots
  // leave it null.
  totalAmount    Decimal?    @db.Decimal(12, 2)
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  createdById    String?     @db.Uuid
  updatedById    String?     @db.Uuid

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  book                  Book                   @relation(fields: [bookId], references: [id])
  party                 Party                  @relation(fields: [partyId], references: [id])
  patternType           PatternType            @relation("CuttingEntryPatternType", fields: [patternTypeId], references: [id])
  item                  Item                   @relation(fields: [itemId], references: [id])
  rows                  CuttingEntryRow[]
  distributions         CuttingDistribution[]
  accessoryTransactions AccessoryTransaction[]
  productionEntries     ProductionEntry[]
  deliveries            Delivery[]

  @@unique([bookId, lotNumber])
  @@map("cutting_entries")
}

// Size Master: the size columns of the cutting grid (e.g. "S" with detail "38/28"), shown in
// sortOrder. Hard-deleted only when no cutting quantity uses it; deactivate to hide it.
model Size {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  detail         String?
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?  @db.Uuid
  updatedById    String?  @db.Uuid

  organization           Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quantities             CuttingRowQuantity[]
  distributionQuantities CuttingDistributionQuantity[]
  deliveryQuantities     DeliveryQuantity[]

  @@unique([organizationId, name])
  @@map("sizes")
}

// One colour within a cutting lot: the cloth photo, its colour and a quantity per size.
model CuttingEntryRow {
  id             String   @id @default(uuid()) @db.Uuid
  cuttingEntryId String   @db.Uuid
  colorId        String   @db.Uuid
  photoUrl       String?
  sortOrder      Int      @default(0)
  // Denormalized sum of this row's quantities, computed server-side.
  totalQuantity  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cuttingEntry CuttingEntry         @relation(fields: [cuttingEntryId], references: [id], onDelete: Cascade)
  color        Color                @relation(fields: [colorId], references: [id])
  quantities   CuttingRowQuantity[]

  @@map("cutting_entry_rows")
}

// Pieces cut for one size within one colour row (only non-zero quantities are stored).
model CuttingRowQuantity {
  id       String @id @default(uuid()) @db.Uuid
  rowId    String @db.Uuid
  sizeId   String @db.Uuid
  quantity Int

  row  CuttingEntryRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  size Size            @relation(fields: [sizeId], references: [id])

  @@unique([rowId, sizeId])
  @@map("cutting_row_quantities")
}

// Cutting Distribution: pieces of a cut lot handed to one karigar, per colour and size. A lot is
// distributed over several entries; what is still left (cut minus every distribution) is derived,
// never stored. Hard-deleted — removing an entry simply returns its pieces to the lot.
model CuttingDistribution {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  cuttingEntryId String   @db.Uuid
  karigarId      String   @db.Uuid
  date           DateTime @db.Date
  // Optional time of day, "HH:mm", same as CuttingEntry.entryTime.
  entryTime      String?
  remarks        String?
  // Denormalized sum of the quantities, computed server-side on every write.
  totalQuantity  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?  @db.Uuid
  updatedById    String?  @db.Uuid

  organization Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cuttingEntry CuttingEntry                  @relation(fields: [cuttingEntryId], references: [id])
  karigar      Karigar                       @relation(fields: [karigarId], references: [id])
  quantities   CuttingDistributionQuantity[]

  @@index([cuttingEntryId])
  @@map("cutting_distributions")
}

// Pieces of one colour + size given in a distribution. Keyed by colour and size rather than by
// cutting row, because cutting rows are recreated whenever the lot is edited.
model CuttingDistributionQuantity {
  id             String @id @default(uuid()) @db.Uuid
  distributionId String @db.Uuid
  colorId        String @db.Uuid
  sizeId         String @db.Uuid
  quantity       Int

  distribution CuttingDistribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  color        Color               @relation(fields: [colorId], references: [id])
  size         Size                @relation(fields: [sizeId], references: [id])

  @@unique([distributionId, colorId, sizeId])
  @@map("cutting_distribution_quantities")
}

// Accessory Master: zips, locks, chains, ID tags… handed to karigars with a lot.
model Accessory {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  // Free text, e.g. "pcs", "meter", "gross".
  unit           String   @default("pcs")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?  @db.Uuid
  updatedById    String?  @db.Uuid

  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        ItemAccessory[]
  lines        AccessoryTransactionLine[]

  @@unique([organizationId, name])
  @@map("accessories")
}

// How much of an accessory one piece of a design needs (e.g. T-shirt: 1 zip, 2 locks). A karigar's
// accessory limit for a lot = pieces of that lot given to them × this.
model ItemAccessory {
  id               String  @id @default(uuid()) @db.Uuid
  itemId           String  @db.Uuid
  accessoryId      String  @db.Uuid
  quantityPerPiece Decimal @db.Decimal(10, 3)

  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  accessory Accessory @relation(fields: [accessoryId], references: [id])

  @@unique([itemId, accessoryId])
  @@map("item_accessories")
}

enum AccessoryTransactionType {
  ISSUE
  RETURN
}

// Accessories issued to, or returned by, a karigar against a lot they took. What the karigar
// still holds (issued − returned − used by finished pieces) is derived, never stored.
model AccessoryTransaction {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @db.Uuid
  type           AccessoryTransactionType
  karigarId      String                   @db.Uuid
  cuttingEntryId String                   @db.Uuid
  date           DateTime                 @db.Date
  // Optional time of day, "HH:mm".
  entryTime      String?
  remarks        String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  createdById    String?                  @db.Uuid
  updatedById    String?                  @db.Uuid

  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  karigar      Karigar                    @relation(fields: [karigarId], references: [id])
  cuttingEntry CuttingEntry               @relation(fields: [cuttingEntryId], references: [id])
  lines        AccessoryTransactionLine[]

  @@index([karigarId, cuttingEntryId])
  @@map("accessory_transactions")
}

model AccessoryTransactionLine {
  id            String  @id @default(uuid()) @db.Uuid
  transactionId String  @db.Uuid
  accessoryId   String  @db.Uuid
  quantity      Decimal @db.Decimal(12, 3)

  transaction AccessoryTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  accessory   Accessory            @relation(fields: [accessoryId], references: [id])

  @@unique([transactionId, accessoryId])
  @@map("accessory_transaction_lines")
}

// Press (ironing): pieces a press karigar hands in. The rate comes from Settings (online / offline)
// at the time of the entry and is kept on the row, so a later rate change doesn't rewrite history.
model PressEntry {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  karigarId      String    @db.Uuid
  date           DateTime  @db.Date
  // Optional time of day, "HH:mm".
  entryTime      String?
  isOnline       Boolean
  pieces         Int
  rate           Decimal   @db.Decimal(10, 2)
  // Denormalized pieces × rate, computed server-side on every write.
  total          Decimal   @db.Decimal(12, 2)
  remarks        String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?   @db.Uuid
  updatedById    String?   @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  karigar      Karigar      @relation(fields: [karigarId], references: [id])

  @@index([organizationId, date])
  @@map("press_entries")
}

// Delivery: finished pieces of a lot sent to its party, per colour and size, with a challan.
// Only produced pieces can go (produced − delivered earlier is derived, never stored). The party
// is the lot's, copied at save so a printed challan never changes. Hard-deleted, like
// distributions.
model Delivery {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  // Running challan number per organization, assigned by the server.
  challanNumber  Int
  cuttingEntryId String   @db.Uuid
  partyId        String   @db.Uuid
  date           DateTime @db.Date
  // Optional time of day, "HH:mm".
  entryTime      String?
  remarks        String?
  // Denormalized sum of the quantities, computed server-side on every write.
  totalQuantity  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?  @db.Uuid
  updatedById    String?  @db.Uuid

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cuttingEntry CuttingEntry       @relation(fields: [cuttingEntryId], references: [id])
  party        Party              @relation(fields: [partyId], references: [id])
  quantities   DeliveryQuantity[]

  @@unique([organizationId, challanNumber])
  @@index([cuttingEntryId])
  @@map("deliveries")
}

model DeliveryQuantity {
  id         String @id @default(uuid()) @db.Uuid
  deliveryId String @db.Uuid
  colorId    String @db.Uuid
  sizeId     String @db.Uuid
  quantity   Int

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  color    Color    @relation(fields: [colorId], references: [id])
  size     Size     @relation(fields: [sizeId], references: [id])

  @@unique([deliveryId, colorId, sizeId])
  @@map("delivery_quantities")
}

model ProductionEntry {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  date           DateTime @db.Date
  // Optional time of day, "HH:mm".
  entryTime      String?
  // Nullable: older entries predate lot tracking, and not every entry may originate from a
  // cutting lot. When set, itemId/carrierQuantity are auto-filled from the matched
  // CuttingEntry and locked client-side (not enforced at the DB level).
  cuttingEntryId String?  @db.Uuid
  lotNumber      String?
  designNumber   String?
  workTypeId     String   @db.Uuid
  itemId         String   @db.Uuid

  carrierId       String   @db.Uuid
  carrierQuantity Int
  carrierRate     Decimal? @db.Decimal(10, 2)
  // Denormalized (carrierQuantity * carrierRate), computed server-side on every write — never
  // trust a client-supplied total, and reports/ledger queries read this column directly instead
  // of recomputing it every time. Same convention for overlockTotal/flatlockTotal below.
  carrierTotal    Decimal  @db.Decimal(12, 2)

  // Overlock and Flatlock are separate finishing stages, each optionally done by a different
  // karigar than the main carrier — both nullable since not every entry needs either.
  overlockCarrierId String?  @db.Uuid
  overlockRate      Decimal? @db.Decimal(10, 2)
  overlockTotal     Decimal? @db.Decimal(12, 2)

  flatlockKarigarId String?  @db.Uuid
  flatlockRate      Decimal? @db.Decimal(10, 2)
  flatlockTotal     Decimal? @db.Decimal(12, 2)

  photoUrl    String?
  remarks     String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  cuttingEntry    CuttingEntry? @relation(fields: [cuttingEntryId], references: [id])
  workType        WorkType      @relation(fields: [workTypeId], references: [id])
  item            Item          @relation(fields: [itemId], references: [id])
  carrier         Karigar       @relation("ProductionEntryCarrier", fields: [carrierId], references: [id])
  overlockCarrier Karigar?      @relation("ProductionEntryOverlockCarrier", fields: [overlockCarrierId], references: [id])
  flatlockKarigar Karigar?      @relation("ProductionEntryFlatlockKarigar", fields: [flatlockKarigarId], references: [id])

  @@map("production_entries")
}

// A small, universal, fixed set — unlike WorkType/ItemCategory this isn't something the client
// customizes per-organization, so a plain enum (not a manageable master) is the right call here.
enum PaymentMode {
  CASH
  BANK_TRANSFER
  UPI
  CHEQUE
}

model Payment {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  karigarId      String      @db.Uuid
  date           DateTime    @db.Date
  // Time of day the payment was entered, "HH:mm" (date and time are set by the server).
  entryTime      String?
  amount         Decimal     @db.Decimal(12, 2)
  paymentMode    PaymentMode
  referenceNo    String?
  remarks        String?
  // Salary of a Fixed karigar, worked out from attendance when the payment is made:
  // salaryAmount = presentDays × perDayRate + overtimeHours × perDayRate ÷ 8. It also counts as
  // what the karigar earned, so the ledger stays balanced. Empty for piece-rate karigars.
  presentDays    Int?
  absentDays     Int?
  overtimeHours  Decimal?    @db.Decimal(6, 2)
  perDayRate     Decimal?    @db.Decimal(12, 2)
  salaryAmount   Decimal?    @db.Decimal(12, 2)
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  createdById    String?     @db.Uuid
  updatedById    String?     @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  karigar      Karigar      @relation(fields: [karigarId], references: [id])

  @@map("payments")
}

enum BackupTrigger {
  MANUAL
  AUTO
}

// A full backup's data is stored as JSON right in Postgres rather than on the filesystem — this
// app already keeps everything in the DB, and a JSON column sidesteps any filesystem/deployment
// path concerns for something that only needs to be written once and read back occasionally.
model Backup {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  triggeredBy    BackupTrigger
  payload        Json
  sizeBytes      Int
  createdAt      DateTime      @default(now())
  createdById    String?       @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("backups")
}
